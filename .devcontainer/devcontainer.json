{
  "name": "TypeScript and SQLite",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15.2"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y sqlite3 libsqlite3-dev && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "qwtel.sqlite-viewer"
      ]
    }
  }
}